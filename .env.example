# Choose your preferred LLM Provider (uncomment the one you want to use)

# Option 1: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini

# Option 2: Google Gemini (Free tier available via Google AI Studio)
# GOOGLE_API_KEY=your_gemini_api_key_here
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.5-flash-lite

# Option 3: Groq (Ultra-fast, generous free tier)
# GROQ_API_KEY=your_groq_api_key_here
# LLM_PROVIDER=groq
# GROQ_MODEL=llama-3.3-70b-versatile

